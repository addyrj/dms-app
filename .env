# ══════════════════════════════════════════════════════════════
# SOPTV  .env
#
# Switch between LOCAL and PRODUCTION by commenting/uncommenting
# ONE of the two "USE_LOCAL" lines below — only one should be active.
# The app has NO hardcoded server addresses anywhere in the code;
# everything comes from whichever block is active here.
# ══════════════════════════════════════════════════════════════

# ── LOCAL mode — TVs connect to a server on the same WiFi/LAN ──
# USE_LOCAL=true
# LOCAL_API_URL=http://localhost:5004,http://192.168.1.102:5004
# LOCAL_MQTT_HOST=localhost
# LOCAL_MQTT_PORT=9001
# LOCAL_MQTT_USER=
# LOCAL_MQTT_PASS=

# ── PRODUCTION mode — TVs connect over the internet to a public server ──
USE_LOCAL=false
PROD_API_URL=https://ispplsop.com
PROD_MQTT_HOST=ispplsop.com
PROD_MQTT_PORT=443
PROD_MQTT_USER=
PROD_MQTT_PASS=
